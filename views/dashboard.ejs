<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RavixMC Application Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#09070f] text-white font-sans min-h-screen flex flex-col md:flex-row">

    <!-- Sidebar -->
    <aside class="w-full md:w-72 bg-[#130f26] border-b md:border-b-0 md:border-r border-purple-500/10 p-6 flex flex-col justify-between shrink-0">
        <div>
            <div class="flex items-center gap-3 mb-8">
                <div class="w-12 h-12 bg-gradient-to-br from-purple-500 to-indigo-600 rounded-2xl flex items-center justify-center font-bold text-white text-xl shadow-lg shadow-purple-500/20">👑</div>
                <div>
                    <span class="font-bold text-xl text-purple-400 block">Application Portal</span>
                    <span class="text-xs text-gray-500">Dashboard</span>
                </div>
            </div>
            
            <nav class="space-y-3">
                <a href="/dashboard" class="flex items-center gap-3 bg-purple-500/10 text-purple-400 px-4 py-3 rounded-xl font-bold border border-purple-500/20">
                    🏠 Home
                </a>
            </nav>
        </div>

        <div class="flex items-center justify-between pt-6 mt-6 border-t border-purple-900/40">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-purple-500/20 border border-purple-500/30 flex items-center justify-center text-purple-400 font-bold">
                    <%= user.username.charAt(0) %>
                </div>
                <div class="overflow-hidden">
                    <h4 class="text-sm font-bold truncate w-28"><%= user.username %></h4>
                    <span class="text-xs text-purple-400/80">Applicant</span>
                </div>
            </div>
            <a href="/logout" title="Logout" class="text-red-400 hover:bg-red-500/10 p-2 rounded-lg transition">🚪</a>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 p-6 md:p-12 overflow-y-auto space-y-10">
        
        <header class="bg-gradient-to-r from-purple-900/30 via-purple-900/10 to-transparent p-8 rounded-3xl border border-purple-500/20">
            <h1 class="text-3xl font-bold mb-3 text-purple-400">Welcome to RavixMC Application Portal 👾</h1>
            <p class="text-gray-300 text-sm leading-relaxed max-w-2xl">Choose the appropriate application and fill out the form carefully.</p>
        </header>

        <!-- Alerts -->
        <% if (typeof customError !== 'undefined' && customError === 'blacklisted') { %>
            <div class="bg-red-950/40 border border-red-500/40 p-6 rounded-3xl flex items-center justify-between shadow-lg">
                <div>
                    <span class="text-xs bg-red-500/20 text-red-400 px-3 py-1 rounded-full font-bold">Blacklisted</span>
                    <h2 class="text-xl font-bold text-red-400 mt-2">Sorry, you are blacklisted 🚫</h2>
                    <p class="text-gray-400 text-xs mt-1">Your account has been added to the blacklist and you cannot apply.</p>
                </div>
            </div>
        <% } else if (typeof customError !== 'undefined' && customError === 'closed') { %>
            <div class="bg-purple-950/40 border border-purple-500/40 p-6 rounded-3xl flex items-center justify-between shadow-lg">
                <div>
                    <span class="text-xs bg-purple-500/20 text-purple-400 px-3 py-1 rounded-full font-bold">Closed</span>
                    <h2 class="text-xl font-bold text-purple-300 mt-2">Applications are currently closed 🔒</h2>
                    <p class="text-gray-400 text-xs mt-1">Staff applications are temporarily closed, please wait until they open again.</p>
                </div>
            </div>
        <% } %>

        <!-- Application Status -->
        <% if (application) { %>
            <% if (application.status === 'pending') { %>
                <div class="bg-amber-500/10 border border-amber-500/30 p-6 rounded-3xl flex items-center justify-between">
                    <div>
                        <span class="text-xs bg-amber-500/20 text-amber-400 px-3 py-1 rounded-full font-bold">Pending</span>
                        <h2 class="text-xl font-bold text-white mt-2">Your application is under review ⏳</h2>
                        <p class="text-gray-400 text-xs mt-1">Your application was submitted successfully on <%= application.date %>, please wait for review.</p>
                    </div>
                </div>
            <% } else if (application.status === 'accepted') { %>
                <div class="bg-emerald-500/10 border border-emerald-500/30 p-6 rounded-3xl flex items-center justify-between">
                    <div>
                        <span class="text-xs bg-emerald-500/20 text-emerald-400 px-3 py-1 rounded-full font-bold">Accepted</span>
                        <h2 class="text-xl font-bold text-emerald-400 mt-2">Congratulations! Your application was accepted 🎉</h2>
                        <p class="text-gray-300 text-xs mt-1">You have been accepted into the staff team.</p>
                    </div>
                </div>
            <% } else if (application.status === 'rejected') { %>
                <div class="bg-red-500/10 border border-red-500/30 p-6 rounded-3xl flex items-center justify-between">
                    <div>
                        <span class="text-xs bg-red-500/20 text-red-400 px-3 py-1 rounded-full font-bold">Rejected</span>
                        <h2 class="text-xl font-bold text-red-400 mt-2">Sorry, your application was not accepted ❌</h2>
                        <p class="text-gray-400 text-xs mt-1">You can contact administration or try again later.</p>
                    </div>
                </div>
            <% } %>
        <% } %>

        <!-- Available Applications -->
        <section class="space-y-6">
            <h2 class="text-xl font-bold text-gray-200">Available Applications</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bg-[#130f26] border border-purple-500/30 p-6 rounded-2xl flex flex-col justify-between space-y-6 shadow-lg shadow-purple-500/5 hover:border-purple-500/50 transition">
                    <div class="space-y-3">
                        <span class="text-xs bg-emerald-500/10 text-emerald-400 px-3 py-1 rounded-full font-bold">Open Now</span>
                        <h3 class="text-xl font-bold text-white">Staff Application Minecraft</h3>
                        <p class="text-gray-400 text-xs leading-relaxed">Join the Minecraft server staff team to help and moderate.</p>
                    </div>
                    
                  <% const appOpen = typeof isAppOpen !== 'undefined' ? isAppOpen : true; %>
                    <% if (!application && appOpen) { %>
                        <a href="/apply" class="w-full text-center bg-gradient-to-r from-purple-600 to-indigo-600 text-white py-3 rounded-xl font-bold transition shadow-lg shadow-purple-600/30 block">Apply Now</a>
                    <% } else if (!appOpen) { %>
                        <button disabled class="w-full bg-gray-800 text-gray-500 py-3 rounded-xl font-bold cursor-not-allowed">Applications Closed</button>
                    <% } else if (application && application.status === 'pending') { %>
                        <button disabled class="w-full bg-gray-800 text-gray-500 py-3 rounded-xl font-bold cursor-not-allowed">Applications Pinding</button>
                    <% } else if (application && application.status === 'accepted') { %>
                        <button disabled class="w-full bg-emerald-600/30 text-emerald-400 py-3 rounded-xl font-bold cursor-not-allowed">Staff Member</button>
                    <% } else if (application && application.status === 'rejected') { %>
                        <button disabled class="w-full bg-red-600/30 text-red-400 py-3 rounded-xl font-bold cursor-not-allowed">Application Rejected</button>
                    <% } else { %>
                        <a href="/apply" class="w-full text-center bg-gradient-to-r from-purple-600 to-indigo-600 text-white py-3 rounded-xl font-bold transition shadow-lg shadow-purple-600/30 block">Re-apply</a>
                    <% } %>
                </div>
            </div>
        </section>

    </main>

</body>
</html>